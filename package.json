{
  "name": "oreum-fps-booster",
  "version": "2.2.1",
  "description": "Windows 게임 FPS·입력지연 최적화 도구 (백업/복원 지원)",
  "main": "src/main.js",
  "author": "Oreum",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "smoke": "set OFB_SMOKE=1&& electron .",
    "build": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.oreum.fpsbooster",
    "productName": "Oreum FPS Booster",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "OreumFPSBooster-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OreumFPSBooster-${version}-setup.exe"
    },
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "PresentMon.exe"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nextvision-1",
        "repo": "oreum-fps-booster",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
